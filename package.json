{
  "name": "scrapemapsapi",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript SDK for the ScrapeMapsAPI API: Google Maps places, details and reviews",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "google-maps",
    "places",
    "reviews",
    "local-business",
    "maps",
    "api",
    "sdk",
    "scrapemapsapi"
  ],
  "author": "ScrapeMapsAPI",
  "license": "MIT",
  "homepage": "https://scrapemapsapi.com",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scrapemapsapi/js-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/scrapemapsapi/js-sdk/issues"
  }
}
